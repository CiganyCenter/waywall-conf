#!/usr/bin/env python3

import urllib.request
import json
import tkinter as tk
import threading
import time
import math
import colorsys

NBB_EVENTS_URL = "http://localhost:52533/api/v1/stronghold/events"

# Pure black background for darkwindow shader to key out
BG_COLOR = "#000000"

FONT = ("Monospace", 11, "bold")
LINE_HEIGHT = 18
PADDING_X = 4
PADDING_Y = 4
WINDOW_WIDTH = 400


SCREEN_X = 1350
SCREEN_Y = 1000


def format_row(prediction, player_pos):
    certainty = prediction["certainty"] * 100
    chunk_x = prediction["chunkX"]
    chunk_z = prediction["chunkZ"]
    dist = int(prediction["overworldDistance"])

    x = chunk_x * 16 + 8
    z = chunk_z * 16 + 8

    angle_str = ""
    if player_pos and "xInOverworld" in player_pos and "zInOverworld" in player_pos:
        dx = x - player_pos["xInOverworld"]
        dz = z - player_pos["zInOverworld"]
        angle = math.degrees(math.atan2(dx, -dz))
        angle_str = f" (-> {angle:.1f})"

    return f"{certainty:.1f}%  ({x}, {z})  {dist}{angle_str}"

def certainty_to_color(certainty):
    hue = certainty * (120 / 360)
    r, g, b = colorsys.hsv_to_rgb(hue, 1.0, 0.87)
    return f"#{int(r * 255):02X}{int(g * 255):02X}{int(b * 255):02X}"

class NBTrackr:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("nbtrackr")
        self.root.configure(bg=BG_COLOR)

        # Prevent focus stealing and keep borderless
        self.root.overrideredirect(True)
        self.root.attributes("-topmost", True)
        self.root.withdraw()

        self.labels = []
        for i in range(3):
            lbl = tk.Label(
                self.root,
                text="",
                font=FONT,
                fg="#FFFFFF",
                bg=BG_COLOR,
                anchor="w",
                padx=PADDING_X,
            )
            lbl.pack(anchor="w")
            self.labels.append(lbl)

        self.visible = False

        self.thread = threading.Thread(target=self.sse_loop, daemon=True)
        self.thread.start()

    def update_display(self, data):
        result_type = data.get("resultType", "NONE")
        predictions = data.get("predictions", [])
        print(f"[update] resultType={result_type} predictions={len(predictions)}", flush=True)
        player_pos = data.get("playerPosition", {})

        if result_type == "NONE" or not predictions:
            if self.visible:
                self.root.withdraw()
                self.visible = False
            return

        rows = min(3, len(predictions))
        height = rows * LINE_HEIGHT + PADDING_Y * 2
        self.root.geometry(f"{WINDOW_WIDTH}x{height}+{SCREEN_X}+{SCREEN_Y}")

        for i in range(3):
            if i < rows:
                self.labels[i].config(
                    text=format_row(predictions[i], player_pos),
                    fg=certainty_to_color(predictions[i]["certainty"]),
                )
                self.labels[i].pack(anchor="w")
            else:
                self.labels[i].pack_forget()

        if not self.visible:
            self.root.deiconify()
            self.visible = True

    def _hide(self):
        if self.visible:
            self.root.withdraw()
            self.visible = False

    def sse_loop(self):
        while True:
            try:
                req = urllib.request.Request(NBB_EVENTS_URL)
                req.add_header("Accept", "text/event-stream")
                with urllib.request.urlopen(req, timeout=60) as response:
                    for raw in response:
                        line = raw.decode("utf-8").rstrip("\n")
                        if line.startswith("data:"):
                            try:
                                data = json.loads(line[5:].strip())
                                self.root.after(0, self.update_display, data)
                            except json.JSONDecodeError:
                                pass
            except Exception:
                print(f"[sse error] {type(e).__name__}: {e}", flush=True)
                self.root.after(0, self._hide)
                time.sleep(3)

    def run(self):
        self.root.mainloop()


if __name__ == "__main__":
    app = NBTrackr()
    app.run()
